# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# Azure AI Search: the service endpoint and an admin key (Azure portal > your search service > Keys)
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<your-search-admin-key>

# Azure OpenAI: endpoint and key (Azure portal > your Azure OpenAI resource > Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>

# The NAME of your chat model deployment (the published results used a gpt-4.1-mini deployment called "chat-mini")
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
